{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowDevStackResourceManagement",
      "Effect": "Allow",
      "Action": [
        "cloudformation:*",
        "lambda:*",
        "s3:*",
        "dynamodb:*",
        "cloudfront:*",
        "cognito-idp:*",
        "logs:*",
        "cloudwatch:*",
        "sns:*",
        "ssm:*",
        "apigateway:*",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:DeleteRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowPassRoleOnlyToDevWorkloadRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::822063948773:role/OpenReception-*-dev-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "AllowPassRoleToCdkProviderRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::822063948773:role/OpenReception-*-dev-Custom*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "AllowRoleMutationOnlyWithBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePolicy",
        "iam:AttachRolePolicy",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::822063948773:policy/OpenReceptionClaudeBoundary"
        }
      }
    },
    {
      "Sid": "AllowCdkProviderRoleMutationWithoutBoundary",
      "Effect": "Allow",
      "Action": ["iam:CreateRole", "iam:PutRolePolicy", "iam:AttachRolePolicy"],
      "Resource": "arn:aws:iam::822063948773:role/OpenReception-*-dev-Custom*"
    },
    {
      "Sid": "DenyIamWriteOnForeignPrincipals",
      "Effect": "Deny",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PutRolePermissionsBoundary",
        "iam:DeleteRolePermissionsBoundary",
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": [
        "arn:aws:iam::*:role/cdk-hnb659fds-*",
        "arn:aws:iam::*:role/cdk-staging-*",
        "arn:aws:iam::*:role/cdk-orcloud01-*",
        "arn:aws:iam::*:role/OpenReceptionClaudeDeploy-dev",
        "arn:aws:iam::*:role/nodi-*",
        "arn:aws:iam::*:role/salon-loop-*",
        "arn:aws:iam::*:role/Kiaff*",
        "arn:aws:iam::*:policy/cdk-hnb659fds-*",
        "arn:aws:iam::*:policy/cdk-staging-*",
        "arn:aws:iam::*:policy/nodi-*",
        "arn:aws:iam::*:policy/salon-loop-*",
        "arn:aws:iam::*:policy/Kiaff*",
        "arn:aws:iam::*:policy/SalonLoop*",
        "arn:aws:iam::*:policy/Nodi*",
        "arn:aws:iam::*:policy/OpenReceptionClaude*",
        "arn:aws:iam::*:user/*",
        "arn:aws:iam::*:role/*DevDeploy*"
      ]
    },
    {
      "Sid": "DenyIamRoleWriteOutsideProject",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRole",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "NotResource": "arn:aws:iam::822063948773:role/OpenReception-*-dev-Custom*",
      "Condition": {
        "StringNotEquals": {
          "aws:ResourceTag/Project": "open-reception"
        }
      }
    },
    {
      "Sid": "DenyForeignProjectStacks",
      "Effect": "Deny",
      "Action": "cloudformation:*",
      "Resource": [
        "arn:aws:cloudformation:*:*:stack/nodi-*/*",
        "arn:aws:cloudformation:*:*:stack/salon-loop-*/*",
        "arn:aws:cloudformation:*:*:stack/Kiaff*/*",
        "arn:aws:cloudformation:*:*:stack/CDKToolkit/*",
        "arn:aws:cloudformation:*:*:stack/CDKToolkit-staging/*",
        "arn:aws:cloudformation:*:*:stack/OpenReception-*-staging/*",
        "arn:aws:cloudformation:*:*:stack/OpenReception-*-prod/*",
        "arn:aws:cloudformation:*:*:stack/OpenReception-DevDeployBroker/*"
      ]
    },
    {
      "Sid": "DenyForeignProjectData",
      "Effect": "Deny",
      "Action": ["dynamodb:*", "s3:*", "logs:*", "cloudwatch:*", "sns:*"],
      "Resource": [
        "arn:aws:dynamodb:*:*:table/nodi-*",
        "arn:aws:dynamodb:*:*:table/salon-loop-*",
        "arn:aws:dynamodb:*:*:table/OpenReception-DevDeployBroker-*",
        "arn:aws:s3:::nodi-*",
        "arn:aws:s3:::salon-loop-*",
        "arn:aws:s3:::cdk-hnb659fds-*",
        "arn:aws:s3:::cdk-hnb659fds-*/*",
        "arn:aws:s3:::cdk-staging-*",
        "arn:aws:logs:*:*:log-group:OpenReception-DevDeployBroker-*",
        "arn:aws:cloudwatch:*:*:alarm:OpenReception-DevDeployBroker-*",
        "arn:aws:sns:*:*:OpenReception-DevDeployBroker-*",
        "arn:aws:s3:::openreception-devdeploy*",
        "arn:aws:s3:::cdk-orbrkr01-*"
      ]
    },
    {
      "Sid": "DenySharedBootstrapRoles",
      "Effect": "Deny",
      "Action": ["sts:AssumeRole", "iam:PassRole"],
      "Resource": [
        "arn:aws:iam::*:role/cdk-hnb659fds-*",
        "arn:aws:iam::*:role/cdk-staging-*",
        "arn:aws:iam::*:role/cdk-orbrkr01-*"
      ]
    },
    {
      "Sid": "DenyRoleCreationWithoutBoundary",
      "Effect": "Deny",
      "Action": ["iam:CreateRole", "iam:PutRolePolicy", "iam:AttachRolePolicy"],
      "NotResource": "arn:aws:iam::822063948773:role/OpenReception-*-dev-Custom*",
      "Condition": {
        "StringNotEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::822063948773:policy/OpenReceptionClaudeBoundary"
        }
      }
    },
    {
      "Sid": "DenyDnsAndPrincipals",
      "Effect": "Deny",
      "Action": [
        "route53:*",
        "acm:*",
        "iam:CreateUser",
        "iam:CreateAccessKey",
        "organizations:*",
        "account:*",
        "logs:*AccountPolicy",
        "s3:Create*AccessPoint*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenySecretsOutside",
      "Effect": "Deny",
      "Action": "secretsmanager:*",
      "NotResource": "arn:aws:secretsmanager:*:822063948773:secret:open-reception/dev/*"
    },
    {
      "Sid": "AllowDevSecretRead",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:*:822063948773:secret:open-reception/dev/*"
    }
  ]
}
